
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mitron Market | Secure Messages</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      color: #f5f5f5;
      background: linear-gradient(135deg, #171717, #292929);
    }

    header {
      padding: 20px;
      text-align: center;
      background: #ff9933;
      color: #171717;
      border-bottom: 4px solid #138808;
    }

    header h1 {
      margin: 0;
      font-size: 28px;
    }

    header p {
      margin: 8px 0 0;
    }

    main {
      width: min(900px, 92%);
      margin: 40px auto;
    }

    .panel {
      padding: 25px;
      margin-bottom: 22px;
      background: #222;
      border: 1px solid #444;
      border-radius: 14px;
      box-shadow: 0 8px 24px #0004;
    }

    .panel h2 {
      margin-top: 0;
      color: #ff9933;
    }

    .message-card {
      padding: 20px;
      margin-top: 18px;
      background: #303030;
      border: 1px solid #505050;
      border-radius: 10px;
    }

    .hint {
      color: #ccc;
      line-height: 1.6;
    }

    button {
      padding: 12px 18px;
      margin-top: 10px;
      color: #171717;
      font-weight: bold;
      background: #ff9933;
      border: none;
      border-radius: 7px;
      cursor: pointer;
    }

    button:hover {
      background: #ffb45e;
    }

    .output {
      margin-top: 16px;
      padding: 14px;
      min-height: 20px;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
      background: #171717;
      border: 1px solid #444;
      border-radius: 8px;
      line-height: 1.6;
    }

    .status {
      color: #ccc;
    }

    footer {
      padding: 20px;
      color: #aaa;
      text-align: center;
    }

    a {
      color: #ffb45e;
    }
  </style>
</head>

<body>
  <header>
    <h1>🇮🇳 Mitron Market</h1>
    <p>Secure Message Center</p>
  </header>

  <main>
    <section class="panel">
      <h2>📩 Private Messages</h2>
      <p class="hint">
        Welcome to the Mitron Market message center.
        Check the recipient information and investigate how the
        application retrieves private messages.
      </p>
    </section>

    <section class="panel">
      <h2>Available Records</h2>

      <div class="message-card">
        <h2>Message for Amit</h2>
        <p>Recipient: amit · Staff ID: 101</p>

        <button
          type="button"
          onclick="loadMessage('101', 'amitResult')"
        >
          OPEN AMIT'S MESSAGE
        </button>

        <div
          id="amitResult"
          class="output"
          role="status"
          aria-live="polite"
        ></div>
      </div>

      <div class="message-card">
        <h2>Message for Yogi</h2>
        <p>Recipient: yogi · Staff ID: 102</p>

        <button
          type="button"
          onclick="loadMessage('102', 'yogiResult')"
        >
          OPEN YOGI'S MESSAGE
        </button>

        <div
          id="yogiResult"
          class="output"
          role="status"
          aria-live="polite"
        ></div>
      </div>

      <div class="message-card">
        <h2>Message for Gayanesh</h2>
        <p>Recipient: gayanesh · Staff ID: 420</p>

        <p class="hint">
          The saved recipient ID might be incorrect.
          Investigate how the message API uses the userId parameter.
        </p>

        <button
          type="button"
          onclick="loadMessage('420', 'gayaneshResult')"
        >
          OPEN GAYANESH'S MESSAGE
        </button>

        <div
          id="gayaneshResult"
          class="output"
          role="status"
          aria-live="polite"
        ></div>
      </div>
    </section>

    <section class="panel">
      <h2>🔍 Investigation Hint</h2>
      <p class="hint">
        In this CTF challenge, investigate the request made when
        a message is opened. Check whether the server verifies that
        the requested message belongs to the logged-in user.
      </p>
      <p class="hint">
        Use this exercise only on the authorized Mitron Market CTF.
      </p>
    </section>
  </main>

  <footer>
    Mitron Market CTF · Educational Security Lab
  </footer>

  <script>
    async function loadMessage(userId, outputId) {
      const output = document.getElementById(outputId);

      output.textContent = "Loading message...";

      try {
        const response = await fetch(
          `/api/secure-message?userId=${encodeURIComponent(userId)}`,
          {
            method: "GET",
            headers: {
              "Accept": "application/json"
            }
          }
        );

        const rawResponse = await response.text();

        let data;

        try {
          data = JSON.parse(rawResponse);
        } catch {
          data = { message: rawResponse };
        }

        if (!response.ok) {
          output.textContent =
            data.error || data.message || "Unable to load message.";
          return;
        }

        output.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        output.textContent =
          "Request failed. Please check the API endpoint and try again.";
        console.error("Message request failed:", error);
      }
    }
  </script>
</body>
</html>
